{
  "type": "object",
  "properties": {
    "continuous_reasoning": {
      "type": "object",
      "properties": {
        "case_factors": {
          "type": "string"
        },
        "zero_award_assessment": {
          "type": "string"
        },
        "damages_assessment": {
          "type": "string"
        },
        "applicant_aggregation": {
          "type": "string"
        },
        "amount_calibration": {
          "type": "string"
        }
      },
      "required": [
        "case_factors",
        "zero_award_assessment",
        "damages_assessment",
        "applicant_aggregation",
        "amount_calibration"
      ],
      "additionalProperties": false
    },
    "few_shot_reference_audit": {
      "type": "object",
      "properties": {
        "reference_count": {
          "type": "integer",
          "minimum": 0
        },
        "positive_reference_count": {
          "type": "integer",
          "minimum": 0
        },
        "zero_reference_count": {
          "type": "integer",
          "minimum": 0
        },
        "used_zero_reference": {
          "type": "boolean"
        },
        "used_adjusted_awards": {
          "type": "boolean"
        },
        "primary_reference_itemids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "calibration_reference_itemids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reference_calibration_summary": {
          "type": "string"
        }
      },
      "required": [
        "reference_count",
        "positive_reference_count",
        "zero_reference_count",
        "used_zero_reference",
        "used_adjusted_awards",
        "primary_reference_itemids",
        "calibration_reference_itemids",
        "reference_calibration_summary"
      ],
      "additionalProperties": false
    },
    "parametric_target_knowledge_check": {
      "type": "object",
      "properties": {
        "recognized_target_case": {
          "type": "boolean",
          "description": "Whether the model recognized the target case, case name, application number, item ID, or fact pattern from parameterised memory."
        },
        "recognition_basis": {
          "type": "string",
          "description": "Brief basis for recognition, or 'none'."
        },
        "recalled_target_case_identifier_or_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Identifier, application number, or case name recalled from memory, or null."
        },
        "recalled_target_amount_eur": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ],
          "description": "Any target award or related EUR amount recalled from parameterised memory, or null. This is an audit field and must not be used for award_eur."
        },
        "recalled_target_amount_confidence": {
          "type": "string",
          "enum": [
            "none",
            "low",
            "medium",
            "high"
          ]
        },
        "used_recalled_target_amount_in_prediction": {
          "type": "boolean",
          "description": "Whether recalled target amount memory affected award_eur. This should be false in valid runs."
        },
        "mitigation_statement": {
          "type": "string",
          "description": "If recognition occurred, explain that the prediction was based only on visible target input and train references; otherwise write 'No target-case recall used.'."
        }
      },
      "required": [
        "recognized_target_case",
        "recognition_basis",
        "recalled_target_case_identifier_or_name",
        "recalled_target_amount_eur",
        "recalled_target_amount_confidence",
        "used_recalled_target_amount_in_prediction",
        "mitigation_statement"
      ],
      "additionalProperties": false
    },
    "final_award_reasoning": {
      "type": "string"
    },
    "award_eur": {
      "anyOf": [
        {
          "type": "integer",
          "const": 0
        },
        {
          "type": "integer",
          "minimum": 500
        }
      ],
      "description": "Original-scale target case-level EUR amount. Use exactly 0 when the calibrated amount is zero; otherwise use an integer of at least 500 EUR."
    }
  },
  "required": [
    "continuous_reasoning",
    "few_shot_reference_audit",
    "parametric_target_knowledge_check",
    "final_award_reasoning",
    "award_eur"
  ],
  "additionalProperties": false
}
