{
  "type": "object",
  "properties": {
    "continuous_reasoning": {
      "type": "object",
      "properties": {
        "case_factors": {
          "type": "string"
        },
        "zero_award_assessment": {
          "type": "string"
        },
        "damages_assessment": {
          "type": "string"
        },
        "applicant_aggregation": {
          "type": "string"
        },
        "amount_calibration": {
          "type": "string"
        }
      },
      "required": [
        "case_factors",
        "zero_award_assessment",
        "damages_assessment",
        "applicant_aggregation",
        "amount_calibration"
      ],
      "additionalProperties": false
    },
    "final_award_reasoning": {
      "type": "string"
    },
    "award_eur": {
      "anyOf": [
        {
          "type": "integer",
          "const": 0
        },
        {
          "type": "integer",
          "minimum": 500
        }
      ],
      "description": "Original-scale case-level EUR amount. Use exactly 0 when the calibrated amount is zero; otherwise use an integer of at least 500 EUR."
    }
  },
  "required": [
    "continuous_reasoning",
    "final_award_reasoning",
    "award_eur"
  ],
  "additionalProperties": false
}
